# ============================================================
# 第四幕 · 四个结局
# ------------------------------------------------------------
# BE《海里的第二个人》：男主跳海换她上岸，死了；她回到现实活下去
# BE《空信箱》        ：男主否认真相、抽身离开；她被海收走，死了
# NE《隔海相望》      ：两人都活着，但此生不能再相见
# 隐藏 GE《旧信箱的回音》：好感 >= 100 + 烈度 < 2 + 集齐 7 片碎片，
#                          把回忆和十二年的信一起还给她，现实中团圆
# ------------------------------------------------------------
# 结局段落强制关闭 AI 聊天，避免模型打乱收尾情绪。
# ============================================================

label ending_path_sea:
    $ ai_chat_enable = False
    jump ending_male_death


label ending_path_deny:
    $ ai_chat_enable = False
    jump ending_female_death


label ending_path_farewell:
    $ ai_chat_enable = False
    jump ending_apart


label ending_path_true:
    $ ai_chat_enable = False
    jump ending_true


# ============================================================
# BE 1 · 海里的第二个人（男主死）
# ============================================================
label ending_male_death:
    $ persistent.new_game_plus = True
    $ persistent.cleared_ending = "male_death"

    scene bg sea_dusk
    with slow_scene

    "我没有再问。"

    "我把外套脱下来，搭在栏杆上，然后翻了过去。"

    show awan fading at awan_center
    with dissolve

    awan "云砚——"

    "她的声音第一次这么急。"

    "水很冷，冷得不像夏天。"
    "我往下沉，看见她的手在水里，像一片没有重量的白。"

    "我抓住了。"

    "这一次，她是实的。"

    awan "你疯了！"

    me "十二年前，我也是这么抓住你的。"

    awan "……"

    me "这次换我。"

    "海在我耳边响，像很多人在同时说话。"
    "我听见她说不要，听见她哭，听见她说她愿意回去，只要我上去。"

    "我把她往岸上推。"

    "推得很用力，像当年有人把我推上岸那样。"

    "她离我越来越远。"
    "最后我看见的，是堤岸上那盏坏了的路灯，亮了一下，又灭了。"

    scene bg black
    with slow_scene

    "镇卫生院说，那个躺了十二年的女孩醒了。"
    "医生说是奇迹。"

    "她醒来的第一句话是：海边是不是有个人在等我。"

    "没有人回答她。"

    "后来她每个周末都去堤岸。"
    "她不知道自己在等谁，只知道要等。"

    "她把信一封一封塞进那只绿色的旧信箱。"
    "信里写的都是些小事：今天天气很好，海很蓝，我梦见一个穿蓝色外套的人。"

    "镇上的人说，那只信箱终于有人收信了。"

    "只是写信的人，永远等不到回信。"

    "—— 结局《海里的第二个人》 ——"

    "（二周目已解锁）"
    return


# ============================================================
# BE 2 · 空信箱（女主死）
# ============================================================
label ending_female_death:
    $ persistent.new_game_plus = True
    $ persistent.cleared_ending = "female_death"

    scene bg sea_dusk
    with slow_scene

    show awan fading at awan_center
    with dissolve

    me "够了。"

    awan "……"

    me "我明天还要上班。"

    "我听见自己说出这句话，像听见另一个人在说话。"

    me "你没有病房，没有名字，没有身份证。"
    me "你只是我不肯承认自己一个人，编出来的东西。"

    "她看着我。"
    "她的眼睛里没有责怪，只有一种很深的、早就料到会这样的安静。"

    awan "……嗯。"

    awan "你说得对。"

    "她往后退了一步。"

    awan "那就当我没出现过。"

    "海风忽然停了。"
    "她的轮廓从边缘开始散，像一张被抽走的纸。"

    awan "云砚。"

    me "……"

    awan "谢谢你，让我被人看见过一次。"

    hide awan
    with fade_slow

    "沙滩上什么都没有留下。"

    scene bg black
    with slow_scene

    "第二天，镇卫生院传出消息：那个躺了十二年的女孩，凌晨走了。"

    "我没有去。"

    "我把那件蓝色的旧外套扔了。"

    "后来我照常上班，照常挤地铁，照常在那趟一小时一班的旧小巴上睡着。"
    "只是每个周末，我还是会回到堤岸。"

    "我往信箱里塞信。"
    "我知道不会有人收。"

    "有一次我忍不住，把信箱撬开了。"

    "里面只有我自己写的信，一封不少。"
    "没有麻绳，没有泛黄的纸，没有别人的字迹。"

    "我在堤岸上坐到天黑。"
    "海还是那个海。"

    "只是从那天起，它再没有回答过我。"

    "—— 结局《空信箱》 ——"

    "（二周目已解锁）"
    return


# ============================================================
# NE · 隔海相望（两人都活着，但永远不能相见）
# ============================================================
label ending_apart:
    $ persistent.new_game_plus = True
    $ persistent.cleared_ending = "apart"

    scene bg sea_dusk
    with slow_scene

    show awan fading at awan_center
    with dissolve

    me "对不起。"

    awan "你今天已经说过很多次了。"

    me "那再说一次。"

    "我在她旁边坐下。"
    "堤岸的石阶还是潮的。天边有一点点白。"

    me "我最后不该那样跟你说话。"

    awan "你说的话不好听。"

    awan "可你最后还是回来了。"

    "她把头靠在我肩上。"
    "很轻，轻得像一片落下来的叶子。"

    awan "云砚，我该回去了。"

    me "回哪儿。"

    awan "回我自己的身体里。"

    me "那不是很好吗。"

    awan "是很好。"

    "她顿了很久。"

    awan "可是海说，回去要拿走一样东西。"

    me "什么。"

    awan "你。"

    "她说的不是我的命。"
    "她说的是，关于我的全部记忆。"

    awan "我醒来以后，会不记得海边，不记得信箱，不记得这七天。"

    awan "也不记得你。"

    "我张了张嘴。"

    awan "还有一件事。"

    awan "如果我以后见到你，海会再把我收回去。"

    awan "所以，你别来找我。"

    "天亮了。"
    "海面上一层一层的白。"

    me "……好。"

    "我听见自己答应得很快。"
    "快到不像答应，像逃。"

    "我握住她的手。"
    "这一次，我握了很久。"

    me "舒瑶。"

    awan "嗯。"

    me "我把这七天再讲一遍给你听。"

    "我讲糖水铺里的甜，讲夜市里那些亮着的灯，讲书店里那本诗集，讲摩天轮升到最高的时候她靠在我肩上。"

    "我讲得很慢。"
    "慢到太阳整个升起来。"

    awan "原来我们去了这么多地方。"

    me "嗯。"

    awan "云砚。"

    me "我在。"

    awan "我要走了。"

    "这一次，她真的走了。"

    hide awan
    with fade_slow

    scene bg black
    with slow_scene

    "三天后，镇卫生院说，那个女孩醒了。"

    "她谁都不认识，连自己叫什么都要想很久。"

    "她的家人把她接走了。"
    "走的那天，她回头看了一眼海。"

    "没有人告诉她，海边有个人在看她。"

    "我搬去了很远的城市。"
    "每年这一天，我还是会坐那趟一小时一班的旧小巴回来。"

    "我不进镇子。"
    "我只在堤岸上站一会儿，把想说的话说完，再坐末班车走。"

    "有一年，我在县城的街上看见她。"

    "她剪了短发，提着一袋橘子，和一个我不认识的人并排走着。"

    "我们隔着一条马路，擦肩而过。"

    "她没有认出我。"

    "可她走过去之后，忽然停下来，回头看了一眼。"

    "像忘了什么，又想不起来。"

    "我没有回头。"

    "我们都没有死。"

    "只是从那以后，我们再没有见过一面。"

    "—— 结局《隔海相望》 ——"

    "（二周目已解锁）"
    return


# ============================================================
# 隐藏 GE · 旧信箱的回音（现实中在一起）
# ============================================================
label ending_true:
    $ persistent.new_game_plus = True
    $ persistent.cleared_ending = "true_end"

    scene bg sea_dusk
    with slow_scene

    show awan fading at awan_center
    with dissolve

    me "舒瑶。"

    awan "嗯。"

    me "你刚才问我要怎么办。"

    "我从口袋里把那些东西一样一样拿出来。"
    "一枚小螺。"
    "一截烧剩的蜡烛。"
    "一张只有海、没有她的照片。"

    "最后，是那叠用麻绳捆着的信。"

    awan "……你都留着。"

    me "不是我留着。"

    me "是你给我的。"

    "我把绳子解开，一封一封念给她听。"
    "念她写的十二年前，念她写的每一年，念她写的「我很高兴，也很害怕」。"

    "念到最后，我的声音已经不太稳。"

    me "还有七片。"

    awan "什么？"

    me "这七天，你给了我七片回忆。"

    $ places_text = "、".join(visited_places)
    me "[places_text]。"

    "我一片一片说给她听。"
    "说到最后一片的时候，她的轮廓不再变淡了。"

    "她低下头，看着自己的手。"

    awan "……是实的。"

    me "嗯。"

    awan "云砚，你知不知道，这样海会——"

    me "我知道。"

    me "海要一个人，我就把十二年份的信都给它。"

    me "它收了我十二年的字，够重了。"

    "海面很静。"
    "远处有早班的渔船，机器声一下一下，像有人在很远的地方敲钟。"

    "风从海上过来，穿过堤岸，穿过我们之间那点距离。"

    "然后，停了。"

    show awan happy at awan_center
    with dissolve

    awan "云砚。"

    me "我在。"

    awan "我好像……可以留下来了。"

    "她伸手碰我的脸。"
    "指尖是凉的，可是有重量。"

    "我握住她的手，没有松开。"

    scene bg black
    with slow_scene

    "那天之后，镇卫生院说，躺了十二年的女孩醒了。"

    "她记得所有事。"
    "记得海，记得信箱，记得糖水铺里的甜，记得摩天轮最高的地方。"

    "也记得我。"

    "我辞了城里的工作。"
    "用攒了几年的钱，在海边租下一间小铺子，卖旧书，也修别人的旧东西。"

    "她恢复得很慢。"
    "一开始只能走半条堤岸，后来能走到信箱那儿，再后来能和我一起坐小巴进城。"

    "我们还是会去糖水铺。"
    "老板娘这次会问「两位吗」。"

    "她还是喜欢吃甜的，还是舍不得吃糖画。"

    "第三年春天，我们领了证。"
    "没有办酒，只请了镇上几个相熟的人。"

    "傍晚的时候，我们沿着堤岸走。"
    "海把天烧成橘色，和第一天一样的颜色。"
    "只是这一次，我们没有隔着那半臂的距离。"

    "风把她的头发吹到我脸上。"

    awan "云砚。"

    me "嗯。"

    awan "你以后还会往信箱里塞信吗？"

    me "不塞了。"

    me "想说的话，我当面说。"

    "她笑起来，眼睛弯成很小的一条缝。"

    awan "那你要说一辈子。"

    me "好。"

    "海还在。"
    "信箱还在。"

    "只是这一次，写信的人不用再等回信了。"

    "—— 隐藏结局《旧信箱的回音》 ——"

    "（二周目已解锁；标题界面会有额外独白）"
    return
